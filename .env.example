# Copy to .env and fill in. Never commit .env or anything under secrets/.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

NODE_ENV=development
HOST=127.0.0.1
PORT=4500
# Public base URL of the IdP; production: https://auth.hoandat.com. In production
# ISSUER, LOCALMAN_WEB_URL, TUNELO_WEB_URL and CHAT_WEB_URL must be explicit public https URLs.
ISSUER=http://localhost:4500
LOG_LEVEL=info

# MongoDB URI that names the database (the IdP uses `auth`).
MONGO_URL=mongodb://127.0.0.1:27017/auth?replicaSet=rs0&directConnection=true

# Private ES256 JWKS created by `pnpm generate-key`; the first key signs.
SIGNING_KEYS_PATH=secrets/signing-keys.json

# Comma-separated cookie signing keys (>= 32 chars each); prepend a new key to rotate.
COOKIE_KEYS=

# First-party confidential clients (>= 32 chars each).
LOCALMAN_WEB_CLIENT_SECRET=
TUNELO_WEB_CLIENT_SECRET=
CHAT_WEB_CLIENT_SECRET=
# Optional: enables scribe-web, scribe-mobile and their entry on /apps.
SCRIBE_WEB_CLIENT_SECRET=
# Optional: enables miu-web, miu-mobile and their entry on /apps.
MIU_WEB_CLIENT_SECRET=

# The one tenant this IdP serves (ADR 0013): resources and audiences are
# derived from its domain (https://localman.<domain>, https://tunnel.<domain>),
# pages and messages show its display name.
TENANT_DOMAIN=hoandat.com
TENANT_DISPLAY_NAME=Auth Next

# Where the client apps live; redirect and logout URIs are derived from these.
LOCALMAN_WEB_URL=https://localman.hoandat.com
TUNELO_WEB_URL=https://tunnel.hoandat.com
CHAT_WEB_URL=https://chat.hoandat.com
# Private-use scheme redirect of the chat mobile app; must match its brand config.
CHAT_MOBILE_REDIRECT_URI=com.hoandat.chat:/auth/callback
SCRIBE_WEB_URL=https://scribe.hoandat.com
SCRIBE_MOBILE_REDIRECT_URI=com.hoandat.scribe:/auth/callback
# Optional pair: a developer's local Scribe (loopback only, exact port).
# SCRIBE_WEB_DEV_URL=http://localhost:5174
# SCRIBE_WEB_DEV_CLIENT_SECRET=
MIU_WEB_URL=https://miu.hoandat.com
MIU_MOBILE_REDIRECT_URI=com.hoandat.miu:/auth/callback
# Optional pair: a developer's local Miu World (loopback only, exact port).
# MIU_WEB_DEV_URL=http://localhost:5173
# MIU_WEB_DEV_CLIENT_SECRET=

# Peers whose X-Forwarded-* headers are believed: loopback, cloudflare, IPs or
# CIDRs; `false` trusts none. In production list the exact address the
# reverse proxy connects from (e.g. its Docker network IP) plus cloudflare,
# e.g. TRUST_PROXY=172.18.0.2,cloudflare. Never trust a whole private range:
# any container on it could then forge a client IP.
TRUST_PROXY=loopback

# Extra Host header values served besides the ISSUER host (other hosts get 421),
# e.g. 127.0.0.1:4500 for local tools. /healthz answers on any host.
ALLOWED_HOSTS=

# --- Sign-in with Google / GitHub (optional) -------------------------------
# Leave a pair empty to hide that button; its routes then answer 404. Register
# the callback URLs at the provider exactly as:
#   Google: ${ISSUER}/oauth/google/callback   GitHub: ${ISSUER}/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Sign in with Apple (optional; primary tenant only; ADR 0008) -----------
# The four together or none; none hides the Apple button and its routes answer
# 404. Return URL to register on the Services ID: ${ISSUER}/oauth/apple/callback;
# server-to-server notifications: ${ISSUER}/oauth/apple/notifications.
# The .p8 key stays in secrets/ (mode 600), never in .env or git.
# Step by step: docs/sign-in-with-apple.md.
APPLE_TEAM_ID=
APPLE_SERVICES_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# Bundle ID of the primary App ID (audience of Apple's notifications).
APPLE_PRIMARY_APP_ID=

# --- iOS account app (optional; primary tenant only) -------------------------
# <TEAMID>.<bundle id> of the app: publishes
# ${ISSUER}/.well-known/apple-app-site-association (universal links for
# /ios/callback and /ios/linked). Unset: that file answers 404.
IOS_APP_ID=
# Push notices over APNs: all four or push stays off. The .p8 auth key (Keys
# with "Apple Push Notifications service") stays in secrets/ (mode 600).
# APNS_TOPIC is the app's bundle ID. See docs/deployment-guide.md.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=

# --- App reviewer sign-in (optional; primary tenant only; ADR 0010) ----------
# Both or none; none (the default) hides the link and /interaction/:uid/review
# answers 404. Only for the App Store review period, then remove both. The hash
# file comes from `printf '%s' "$PASSWORD" | pnpm -s review-login:hash` and must
# be mode 600. See docs/deployment-guide.md.
REVIEW_LOGIN_EMAIL=
REVIEW_LOGIN_PASSWORD_HASH_PATH=

# --- Telegram bot (optional; all three or none) ------------------------------
# Used to link a chat to an account and to send password reset links. Without
# it the Telegram options are hidden. Webhook: ${ISSUER}/telegram/webhook, set
# with secret_token=TELEGRAM_WEBHOOK_SECRET (32-256 chars of A-Z a-z 0-9 _ -).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Only for tests or a Bot API proxy; defaults to https://api.telegram.org.
TELEGRAM_API_BASE_URL=

# --- Audit events to Localman (optional; all three or none) -----------------
# Credential events (sign-ins, password changes, links, revocations) always go
# to the MongoDB outbox `audit_outbox`. With these set, a background dispatcher
# POSTs each one as a signed SET (application/secevent+jwt, aud = this exact
# URL, expires 10 min after signing) with Authorization: Basic base64(id:secret)
# and the event id as Idempotency-Key, retrying with backoff (5 s doubling, at
# most 1 h). Without them events wait in the outbox; IP/User-Agent of events
# waiting over 30 days are erased. In production the URL must be https; it may
# not embed user:pass. e.g.
# AUDIT_EVENTS_URL=https://localman.hoandat.com/internal/audit-events
AUDIT_EVENTS_URL=
# No ':' or whitespace (it is joined with the secret for HTTP Basic).
AUDIT_CLIENT_ID=
# >= 32 chars; Localman stores the same value to check the Basic credentials.
AUDIT_CLIENT_SECRET=

# --- App usage statistics (ADR 0011) ---------------------------------------
# Each sign-in into an app is recorded in `client_usage` (account, client,
# time, interactive or sso; no IP or browser), kept 400 days, for the weekly
# `dist/growth-report.mjs`. On by default; false stops new records after a
# restart (what is stored stays until its TTL).
CLIENT_USAGE_ENABLED=
