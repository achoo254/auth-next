# Renews tenants' certificates in their own config dir; the machine's
# certbot-renew.timer only covers /etc/letsencrypt. The tenants' server
# blocks read certificates at handshake, so no nginx reload is needed.
[Unit]
Description=Renew hoandat-auth tenant certificates
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/certbot renew --config-dir /etc/letsencrypt-tenants --work-dir /etc/letsencrypt-tenants/work --logs-dir /etc/letsencrypt-tenants/logs --non-interactive
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/letsencrypt-tenants /var/lib/hoandat-tenant-acme
