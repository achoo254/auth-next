# Issues and removes tenants' certificates (ADR 0006): one pass of the
# queue in the IdP's internal API. Root, because certbot writes under /etc
# and the provisioner's private key opens DNS tokens. It runs a root-owned
# copy (setup-provisioner.sh), never the IdP's tree, and shares a lock with
# the renew timer (certbot refuses to run twice on one config dir).
[Unit]
Description=hoandat-auth tenant certificate provisioner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/hoandat-tenant-provisioner/env
# Node comes from root's nvm on this host.
ExecStart=/usr/bin/flock /etc/letsencrypt-tenants/.lock /bin/bash -c 'source /root/.nvm/nvm.sh >/dev/null && exec node /usr/local/lib/hoandat-tenant-provisioner/tenant-provisioner.mjs run'
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/letsencrypt-tenants /var/lib/hoandat-tenant-acme /etc/hoandat-tenant-provisioner/credentials
TimeoutStartSec=15min
