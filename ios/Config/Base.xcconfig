// Build settings shared by every configuration of the AccountApp target.
// The issuer is the primary tenant's IdP; universal links, associated
// domains and the API all derive from it. xcconfig treats "//" as a
// comment, so only the host lives here and Info.plist adds "https://".
ISSUER_HOST = auth.hoandat.com

PRODUCT_BUNDLE_IDENTIFIER = com.hoandat.account
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// Signing: automatic, team chosen locally (Local.xcconfig, not committed).
// CI builds with CODE_SIGNING_ALLOWED=NO.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = AccountApp/Resources/AccountApp.entitlements

#include? "Local.xcconfig"
