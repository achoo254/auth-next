{
  "sourceLanguage": "en",
  "strings": {
    "%@ linked.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã liên kết %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关联 %@。"
          }
        }
      }
    },
    "%@ on %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ trên %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 上的 %1$@"
          }
        }
      }
    },
    "%@ on that device will have to sign in again.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ trên thiết bị đó sẽ phải đăng nhập lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设备上的 %@ 需要重新登录。"
          }
        }
      }
    },
    "%@ unlinked.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã huỷ liên kết %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消关联 %@。"
          }
        }
      }
    },
    "Access removed.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gỡ quyền truy cập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除访问权限。"
          }
        }
      }
    },
    "Account": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户"
          }
        }
      }
    },
    "Account is locked": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản đang bị khoá"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户已锁定"
          }
        }
      }
    },
    "All browser sessions signed out.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đăng xuất mọi phiên trình duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已退出所有浏览器会话。"
          }
        }
      }
    },
    "Allow notifications in Settings": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép thông báo trong Cài đặt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中允许通知"
          }
        }
      }
    },
    "Apps with access": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng có quyền truy cập"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有访问权限的应用"
          }
        }
      }
    },
    "Asks for Face ID or your passcode when you open the app.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏi Face ID hoặc mật mã máy khi bạn mở app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开应用时要求面容 ID 或设备密码。"
          }
        }
      }
    },
    "Browser sessions": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên trình duyệt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器会话"
          }
        }
      }
    },
    "Can read: %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được đọc: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可读取：%@"
          }
        }
      }
    },
    "Confirm to change the app lock": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận để đổi khoá app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认以更改应用锁"
          }
        }
      }
    },
    "Connections": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        }
      }
    },
    "Could not load your account": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tải được tài khoản"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载您的账户"
          }
        }
      }
    },
    "Created": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày tạo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建时间"
          }
        }
      }
    },
    "Data inside the other apps (projects, messages, notes) is not deleted by this. Domains you own keep following your Google, GitHub or Apple account.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu trong các app khác (dự án, tin nhắn, ghi chú) không bị xoá theo. Domain bạn sở hữu vẫn theo tài khoản Google, GitHub hoặc Apple của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他应用中的数据（项目、消息、笔记）不会因此删除。您拥有的域名仍归属于您的 Google、GitHub 或 Apple 账户。"
          }
        }
      }
    },
    "Delete account": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoá tài khoản"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除账户"
          }
        }
      }
    },
    "Delete your account now?": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoá tài khoản ngay bây giờ?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在删除您的账户？"
          }
        }
      }
    },
    "Deleting your account cannot be undone.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoá tài khoản thì không hoàn tác được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除账户后无法撤销。"
          }
        }
      }
    },
    "Details": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi tiết"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "详细信息"
          }
        }
      }
    },
    "Device signed out.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đăng xuất thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备已退出登录。"
          }
        }
      }
    },
    "Devices": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备"
          }
        }
      }
    },
    "Display name": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên hiển thị"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示名称"
          }
        }
      }
    },
    "Email": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Email"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电子邮件"
          }
        }
      }
    },
    "Expires %@ unless used": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hết hạn %@ nếu không dùng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如不使用将于 %@ 过期"
          }
        }
      }
    },
    "Get a notification when someone signs in, a sign-in method changes or access is removed.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận thông báo khi có người đăng nhập, phương thức đăng nhập thay đổi hoặc quyền truy cập bị gỡ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人登录、登录方式变更或访问权限被移除时收到通知。"
          }
        }
      }
    },
    "It is no longer there. The list has been refreshed.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục này không còn nữa. Danh sách đã được làm mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该项目已不存在，列表已刷新。"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngôn ngữ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言"
          }
        }
      }
    },
    "Last active %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt động gần nhất %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近活动 %@"
          }
        }
      }
    },
    "Link %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关联 %@"
          }
        }
      }
    },
    "Linked (details unknown)": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã liên kết (không rõ chi tiết)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关联（详情未知）"
          }
        }
      }
    },
    "Linked on %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết lúc %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关联于 %@"
          }
        }
      }
    },
    "Linked, but this method is turned off on the sign-in server.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã liên kết, nhưng máy chủ đăng nhập đang tắt phương thức này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关联，但登录服务器已停用此方式。"
          }
        }
      }
    },
    "Linked.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã liên kết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关联。"
          }
        }
      }
    },
    "Linking did not complete. Please try again.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết chưa hoàn tất. Vui lòng thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关联未完成，请重试。"
          }
        }
      }
    },
    "Linking or removing a method asks you to sign in again first.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết hoặc gỡ một phương thức sẽ yêu cầu bạn đăng nhập lại trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关联或移除登录方式前需要重新登录。"
          }
        }
      }
    },
    "Loading…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tải…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载…"
          }
        }
      }
    },
    "Lock with Face ID": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoá bằng Face ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用面容 ID 锁定"
          }
        }
      }
    },
    "Lock with Optic ID": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoá bằng Optic ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Optic ID 锁定"
          }
        }
      }
    },
    "Lock with Touch ID": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoá bằng Touch ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用触控 ID 锁定"
          }
        }
      }
    },
    "Lock with passcode": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoá bằng mật mã máy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用设备密码锁定"
          }
        }
      }
    },
    "Manage your profile, sign-in methods, sessions and devices, and get notified about security events.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý hồ sơ, phương thức đăng nhập, phiên và thiết bị, và nhận thông báo về sự kiện bảo mật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理您的个人资料、登录方式、会话和设备，并接收安全事件通知。"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
    "New sign-ins, sign-in method changes and removed access. Notifications never contain codes or links.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượt đăng nhập mới, thay đổi phương thức đăng nhập và quyền truy cập bị gỡ. Thông báo không bao giờ chứa mã hay đường link."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新的登录、登录方式变更和被移除的访问权限。通知中绝不包含验证码或链接。"
          }
        }
      }
    },
    "No app has access to your account.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có ứng dụng nào có quyền truy cập tài khoản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有应用可以访问您的账户。"
          }
        }
      }
    },
    "No browser is signed in to your account.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có trình duyệt nào đang đăng nhập tài khoản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有浏览器登录您的账户。"
          }
        }
      }
    },
    "No device is signed in.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có thiết bị nào đang đăng nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已登录的设备。"
          }
        }
      }
    },
    "No email": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có email"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无电子邮件"
          }
        }
      }
    },
    "Not available": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không khả dụng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不可用"
          }
        }
      }
    },
    "Not linked": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa liên kết"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未关联"
          }
        }
      }
    },
    "Not verified": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xác minh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未验证"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "On %@, %@ was taken back by the person who verified it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lúc %1$@, email %2$@ đã được người xác minh nó lấy lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，%2$@ 已被验证该地址的人收回。"
          }
        }
      }
    },
    "Opens the sign-in page with Google, GitHub or Apple.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở trang đăng nhập bằng Google, GitHub hoặc Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开使用 Google、GitHub 或 Apple 的登录页面。"
          }
        }
      }
    },
    "Our app": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng của chúng tôi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们的应用"
          }
        }
      }
    },
    "Please confirm it's you again, then retry.": {
