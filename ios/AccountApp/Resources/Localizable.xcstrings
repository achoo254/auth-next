    "Working…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang xử lý…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理…"
          }
        }
      }
    },
    "You are offline": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang ngoại tuyến"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您处于离线状态"
          }
        }
      }
    },
    "You are offline. Check your connection and try again.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang ngoại tuyến. Hãy kiểm tra kết nối rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您处于离线状态，请检查网络连接后重试。"
          }
        }
      }
    },
    "You are offline. Showing the last loaded information.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang ngoại tuyến. Đang hiển thị thông tin tải lần cuối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您处于离线状态，正在显示上次加载的信息。"
          }
        }
      }
    },
    "You can no longer sign in with this account to Localman, Tunelo, Chat, Scribe or any other app that uses it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ không đăng nhập được Localman, Tunelo, Chat, Scribe hay bất kỳ app nào khác bằng tài khoản này nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您将无法再使用此账户登录 Localman、Tunelo、Chat、Scribe 或任何其他使用它的应用。"
          }
        }
      }
    },
    "You signed in to a different account. Confirm with the account you are using in this app.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn vừa đăng nhập vào một tài khoản khác. Hãy xác nhận bằng tài khoản đang dùng trong app này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您登录了另一个账户。请使用此应用中正在使用的账户确认。"
          }
        }
      }
    },
    "You will be asked to sign in again before the account is deleted.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ được yêu cầu đăng nhập lại trước khi tài khoản bị xoá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除账户前将要求您重新登录。"
          }
        }
      }
    },
    "You will be asked to sign in again to confirm.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ được yêu cầu đăng nhập lại để xác nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将要求您重新登录以确认。"
          }
        }
      }
    },
    "You will be asked to sign in again to confirm. The app loses access on every device.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ được yêu cầu đăng nhập lại để xác nhận. Ứng dụng sẽ mất quyền truy cập trên mọi thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将要求您重新登录以确认。该应用将在所有设备上失去访问权限。"
          }
        }
      }
    },
    "You will no longer be able to sign in with %@.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ không đăng nhập bằng %@ được nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您将无法再使用 %@ 登录。"
          }
        }
      }
    },
    "Your account has been deleted.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản của bạn đã được xoá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的账户已删除。"
          }
        }
      }
    },
    "Your only way to sign in, so it cannot be removed.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là cách đăng nhập duy nhất nên không gỡ được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是您唯一的登录方式，因此无法移除。"
          }
        }
      }
    },
    "Your profile, linked sign-in methods, sessions, devices and app access are deleted right away, and Apple sign-in is revoked.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ, phương thức đăng nhập đã liên kết, phiên, thiết bị và quyền của ứng dụng bị xoá ngay, và đăng nhập Apple bị thu hồi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的个人资料、已关联的登录方式、会话、设备和应用访问权限将立即删除，Apple 登录也会被撤销。"
          }
        }
      }
    },
    "Your session has ended. Please sign in again.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên đăng nhập đã kết thúc. Vui lòng đăng nhập lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的会话已结束，请重新登录。"
          }
        }
      }
    }
  },
  "version": "1.0"
}