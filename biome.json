{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignore": [
			"**/dist",
			"**/dist/**",
			"**/portal-dist",
			"**/portal-dist/**",
			"**/*.d.ts",
			"**/*.tsbuildinfo",
			"**/node_modules",
			"**/node_modules/**",
			".pnpm-store",
			".pnpm-store/**",
			".claude/**",
			"**/.claude/**",
			"pnpm-lock.yaml",
			"plans/**",
			"brand/generated/**",
			"**/*.css",
			"**/*.html"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 80
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "error"
			},
			"style": {
				"noNonNullAssertion": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
