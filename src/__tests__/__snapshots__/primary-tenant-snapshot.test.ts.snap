<div class="app-card-foot"><a class="btn btn-secondary" href="https://miu.hoandat.com" data-id="app-open-miu-web">打开</a></div>
</li><li class="app-card tone-amber" data-id="app-tieude-web">
<div class="app-card-head">
<span class="app-card-icon"><img class="app-mark" src="/assets/img/apps/tieude-mark-128.webp" width="44" height="44" alt=""></span>
<div class="app-card-heading"><h3 class="app-card-name">Tiểu Đệ</h3>
<p class="app-card-meta"><span class="badge badge-neutral">网页应用</span><span class="mono">tieude.hoandat.com</span></p></div>
</div>
