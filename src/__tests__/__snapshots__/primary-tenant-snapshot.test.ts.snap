<span class="app-card-icon"><img class="app-mark" src="/assets/img/apps/scribe-mark-128.webp" width="44" height="44" alt=""></span>
<div class="app-card-heading"><h3 class="app-card-name">Scribe</h3>
<p class="app-card-meta"><span class="badge badge-neutral">网页应用</span><span class="mono">scribe.hoandat.com</span></p></div>
</div>
