<div class="app-card-foot"><a class="btn btn-secondary" href="https://tunnel.hoandat.com" data-id="app-open-tunelo-web">打开</a></div>
</li><li class="app-card tone-blue" data-id="app-chat-web">
<div class="app-card-head">
<span class="app-card-icon"><img class="app-mark" src="/assets/img/apps/chat-mark-128.webp" width="44" height="44" alt=""></span>
