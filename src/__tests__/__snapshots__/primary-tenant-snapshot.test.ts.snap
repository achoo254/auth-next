exports[`primary tenant (hoandat.com) is unchanged > keeps cookie names and attributes (no Domain, same prefixes) 1`] = `
{
  "interaction": "__Secure-interaction",
  "resume": "__Secure-interaction_resume",
  "session": "__Host-session",
}
`;

exports[`primary tenant (hoandat.com) is unchanged > keeps cookie names and attributes (no Domain, same prefixes) 2`] = `
[
  "_interaction=VALUE; path=/interaction/UID; expires=DATE; samesite=lax; httponly",
  "_interaction.sig=VALUE; path=/interaction/UID; expires=DATE; samesite=lax; httponly",
  "_interaction_resume=VALUE; path=/auth/UID; expires=DATE; samesite=lax; httponly",
  "_interaction_resume.sig=VALUE; path=/auth/UID; expires=DATE; samesite=lax; httponly",
]
`;

