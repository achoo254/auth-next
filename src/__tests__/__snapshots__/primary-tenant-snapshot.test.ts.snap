  "device.confirm.help": "Chỉ tiếp tục nếu mã trên khớp với mã đang hiện trên máy của bạn.",
  "device.confirm.match": "Mã khớp, tiếp tục",
  "device.confirm.subtitle": "Yêu cầu từ {device}.",
  "device.confirm.title": "Kiểm tra mã thiết bị",
  "device.error.aborted": "Đã từ chối. Máy kia sẽ không được cấp quyền.",
  "device.error.expired": "Mã đã hết hạn. Chạy lại lệnh đăng nhập trên máy để lấy mã mới.",
  "device.error.noCode": "Hãy nhập mã đang hiện trên máy của bạn.",
  "device.error.notFound": "Mã không đúng. Kiểm tra lại mã trên máy của bạn.",
  "device.error.other": "Không xử lý được yêu cầu. Thử lại sau ít phút.",
  "device.error.used": "Mã này đã được dùng. Chạy lại lệnh đăng nhập trên máy.",
  "device.genericLabel": "thiết bị",
  "device.input.label": "Mã thiết bị",
  "device.input.subtitle": "Nhập mã đang hiện trên máy (ví dụ trong cửa sổ dòng lệnh của tunelo).",
  "device.input.title": "Đăng nhập thiết bị",
  "device.onMachine": "{app} trên máy {machine}",
  "device.success.alert": "Quay lại cửa sổ dòng lệnh, máy sẽ tự tiếp tục. Bạn có thể đóng trang này.",
  "device.success.manage": "Quản lý thiết bị ở trang tài khoản",
  "device.success.pageTitle": "Đã cho phép thiết bị",
  "device.success.subtitle": "{device} đã đăng nhập vào tài khoản của bạn.",
  "device.success.title": "Đã cho phép",
  "device.unknownName": "không rõ tên",
  "error.code": "Mã lỗi: {code}",
  "error.consentMissing": "Không tìm thấy tài khoản hoặc ứng dụng của phiên này. Quay lại ứng dụng và đăng nhập lại.",
  "error.formExpired": "Biểu mẫu đã hết hạn. Tải lại trang rồi thử lại.",
  "error.interactionExpired": "Phiên đăng nhập đã hết hạn hoặc không còn hợp lệ. Quay lại ứng dụng và đăng nhập lại.",
  "error.otherInteraction": "Trang này thuộc về một phiên đăng nhập khác. Quay lại ứng dụng và đăng nhập lại.",
  "error.title": "Không thể tiếp tục",
  "error.unsupportedStep": "Bước đăng nhập này chưa được hỗ trợ.",
  "guide.admin.body": "Bấm Mở trang quản trị. Liên kết dùng một lần, trong 2 phút, mở phiên quản trị 30 phút ở auth.<domain>/admin; hết phiên thì mở lại từ {claim}.",
  "guide.admin.deadline": "Thêm cách đăng nhập trong 48 giờ: quá hạn mà chưa có thì domain bị gỡ và nhận lại được từ đầu.",
  "guide.admin.figure": "Trang quản trị: trạng thái, địa chỉ và chứng chỉ ở trên cùng.",
  "guide.admin.title": "4. Mở trang quản trị",
  "guide.claim.body": "Mở {claim}, nhập domain và chọn danh tính chủ. Lượt nhận sống 24 giờ.",
  "guide.claim.figure": "Bắt đầu nhận domain: domain và chủ của nó.",
  "guide.claim.title": "1. Bắt đầu nhận domain",
  "guide.dns.body": "Trang liệt kê một bản ghi TXT và sáu bản ghi A. Bấm vào tên hoặc giá trị để chọn cả ô, rồi copy sang nhà cung cấp DNS.",
  "guide.dns.cloudflareRecordFigure": "Cloudflare, DNS, Add record: bản ghi A để DNS only (mây xám).",
  "guide.dns.dnsOnly": "Chỉ DNS (khuyên dùng): bản ghi A trỏ thẳng về máy chủ. Mọi thứ đều chạy, kể cả kết nối thời gian thực của Chat và mọi subdomain.",
  "guide.dns.figure": "Các bản ghi cần thêm, với giá trị của bạn.",
  "guide.dns.flexible": "Tránh Flexible: khi đó Cloudflare cắt kết nối thời gian thực của Chat nên tin nhắn không đồng bộ. Nếu zone buộc phải để Flexible, thêm một Configuration Rule đặt SSL Full (strict) cho chat.<domain>.",
  "guide.dns.keepTxt": "Giữ bản ghi TXT sau khi nhận xong: máy chủ kiểm lại 6 giờ một lần, domain sai 3 lần liền bị tạm đình chỉ tới khi DNS đúng lại.",
  "guide.dns.proxied": "Bật proxy Cloudflare (mây cam) cũng được, với SSL của zone để Full (strict). Máy chủ có chứng chỉ thật cho các host này.",
  "guide.dns.sslModeFigure": "Cloudflare, SSL/TLS: với host bật proxy, chọn Full (Strict) rồi Save, không chọn Flexible.",
  "guide.dns.title": "2. Thêm bản ghi DNS",
  "guide.dns.wildcard": "*.localman. và *.tunnel. là wildcard hai cấp: gói free của Cloudflare không có chứng chỉ edge cho chúng. Để Chỉ DNS, trừ khi bạn trả phí cho chứng chỉ đó.",
  "guide.figure": "Hình {number}.",
  "guide.intro": "Thiết lập xong, người dùng của bạn đăng nhập ở auth.<domain>, dùng Chat ở chat.<domain>, Localman ở localman.<domain> và Tunelo ở tunnel.<domain>. Không cần cài gì: mọi thứ chạy trên máy chủ của hoandat.com. Tài khoản, phiên, project và tunnel của domain bạn không bao giờ lẫn với domain khác.",
  "guide.keep.body": "Domain còn là của bạn khi bản ghi TXT còn và các bản ghi trỏ về máy chủ. Muốn gỡ: xoá bản ghi TXT hoặc nhờ người vận hành; chứng chỉ, token và mọi dữ liệu của domain bị xoá, domain nhận lại được từ đầu.",
  "guide.keep.title": "Giữ hoặc gỡ domain",
  "guide.prepare.account": "Một tài khoản ở auth.hoandat.com đã liên kết Google hoặc GitHub. Danh tính Google hoặc GitHub đó là chủ của domain.",
  "guide.prepare.cloudflare": "Nên có: DNS nằm trên Cloudflare, kèm một API token (bước 6). Thiếu token thì mock và tunnel trên subdomain không có chứng chỉ.",
  "guide.prepare.dns": "Quyền sửa DNS của domain. Subdomain của domain bạn sở hữu (dev.example.com) cũng được.",
  "guide.prepare.oauth": "Một tài khoản Google Cloud hoặc GitHub để tạo app đăng nhập cho domain (bước 5).",
  "guide.prepare.title": "Cần chuẩn bị",
  "guide.self.apps": "App đăng nhập Google hoặc GitHub của riêng bạn, và một widget Cloudflare Turnstile cho localman.<domain>.",
  "guide.self.body": "Khi {claim} có lựa chọn này, chọn Trên máy chủ của bạn ở bước 1. Bạn chỉ thêm bản ghi TXT; các host trỏ về máy chủ của bạn, không trỏ về đây. Domain xác minh xong thì tải gói cài đặt (hạn 24 giờ) và làm theo {installGuide}. Máy chủ của bạn hoàn tất thiết lập với Auth Next một lần, sau đó không gì đi qua hoandat.com nữa.",
  "guide.self.cloudflare": "DNS trên Cloudflare kèm API token sửa được zone: chứng chỉ wildcard của *.localman. và *.tunnel. chứng minh qua DNS.",
  "guide.self.duty": "Auth Next không backup, không cập nhật, không vá bảo mật và không giám sát máy chủ của bạn: các việc đó do bạn lo. Giữ bản ghi TXT để không ai nhận lại domain ở đây.",
  "guide.self.installGuide": "hướng dẫn cài đặt",
  "guide.self.move": "Chuyển một domain đang chạy ở đây: trong mục Domain của bạn, bấm Chuyển sang máy chủ của bạn. Domain ngừng phục vụ ở đây ngay, dữ liệu được giữ; Huỷ chuyển cho nó chạy lại. Cài gói nhưng chưa trỏ bản ghi A về máy chủ của bạn, rồi gửi khoá chuyển công khai của bản cài cho người vận hành. Người vận hành xuất tài khoản, project, biến, khoá tunnel và tin nhắn của domain, chỉ máy chủ của bạn mở được; nhập chúng ở đó rồi trỏ bản ghi A về máy chủ của bạn. Token đã cấp vẫn dùng được; người dùng đăng nhập lại Localman và Chat một lần.",
  "guide.self.server": "Một máy Linux có Docker Compose, IPv4 công khai, mở cổng 80, 443 và dải cổng TCP của Tunelo, khoảng 4 GB RAM trống.",
  "guide.self.title": "Chạy domain trên máy chủ của bạn",
  "guide.signin.body": "Người dùng đăng nhập bằng một app Google hoặc GitHub của riêng domain bạn. Một cái là đủ; thêm cả hai cũng được.",
  "guide.signin.github": "GitHub: Settings, Developer settings, OAuth Apps, New OAuth App. Homepage URL https://auth.<domain>, redirect URI https://auth.<domain>/oauth/github/callback. Sau đó tạo client secret.",
  "guide.signin.githubFigure": "GitHub, Register a new OAuth app: trang chủ và redirect URI.",
  "guide.signin.googleBranding": "Google: trong Google Cloud, mở Google Auth Platform, Branding. Điền trang chủ https://auth.<domain>, chính sách quyền riêng tư https://auth.<domain>/privacy (trang này có sẵn) và thêm domain của bạn vào authorized domains.",
  "guide.signin.googleBrandingFigure": "Google Auth Platform, Branding: trang chủ, chính sách quyền riêng tư và authorized domain.",
  "guide.signin.googleClient": "Rồi Clients, Create client: loại Web application, authorized redirect URI https://auth.<domain>/oauth/google/callback.",
  "guide.signin.googleClientFigure": "Create OAuth client ID: Web application và redirect URI của nó.",
  "guide.signin.paste": "Dán client ID và client secret vào trang quản trị rồi lưu. Domain hoạt động ngay khi có một cách đăng nhập. Secret không bao giờ hiện lại, và không gỡ được cách đăng nhập cuối cùng.",
  "guide.signin.pasteFigure": "Trang quản trị hiện đúng callback URL cần đăng ký.",
  "guide.signin.title": "5. Thêm đăng nhập Google hoặc GitHub",
  "guide.subtitle": "Chạy đăng nhập, Chat, Localman và Tunelo trên domain bạn sở hữu, với tài khoản riêng.",
  "guide.title": "Dùng domain của riêng bạn",
  "guide.token.body": "Mock (<secret>.localman.<domain>) và tunnel (<tên>.tunnel.<domain>) cần chứng chỉ wildcard, chứng minh qua DNS. Ở dash.cloudflare.com: My Profile, API Tokens, Create Token, mẫu Edit zone DNS, chọn zone của domain. Dán vào trang quản trị; trang thử tạo rồi xoá một bản ghi TXT, rồi niêm phong token cho dịch vụ cấp chứng chỉ.",
  "guide.token.createFigure": "Quyền Zone DNS Edit, giới hạn ở domain của bạn trong Zone Resources.",
  "guide.token.figure": "Chỗ dán token Cloudflare.",
  "guide.token.templateFigure": "Cloudflare, API Tokens, Create Token: dùng mẫu Edit zone DNS.",
  "guide.token.title": "6. Token Cloudflare (DNS trên Cloudflare)",
  "guide.token.without": "Thiếu token thì các trang chính vẫn chạy; mock và tunnel trên subdomain thì không.",
  "guide.users.accounts": "Tài khoản: https://auth.<domain>. Tách hẳn tài khoản ở hoandat.com, kể cả khi cùng một người.",
  "guide.users.chat": "Chat: https://chat.<domain>.",
  "guide.users.localman": "Localman: https://localman.<domain>; mock ở https://<secret>.localman.<domain>; MCP ở https://localman.<domain>/mcp.",
  "guide.users.scribe": "Scribe (chép lời, biên bản), sau khi bạn thêm key AI ở mục Scribe của trang quản trị, nếu máy chủ có mục này: https://scribe.<domain>.",
  "guide.users.title": "7. Người dùng của domain",
  "guide.users.tunelo": "Tunelo: CLI 1.8.0 trở lên (npm install -g tunelo@latest), rồi tunelo login --server https://tunnel.<domain>.",
  "guide.verify.body": "Đợi vài phút cho DNS lan rồi bấm Kiểm tra DNS. Bản ghi nào chưa trỏ về máy chủ sẽ được đánh dấu; sửa rồi kiểm tra lại.",
  "guide.verify.done": "Khi mọi bản ghi đều đúng, domain thuộc về bạn và chứng chỉ được cấp trong vài phút. Domain hiện trong mục Domain của bạn.",
  "guide.verify.doneFigure": "Domain đã nhận, sẵn sàng mở trang quản trị.",
  "guide.verify.title": "3. Kiểm tra DNS",
  "guide.verify.wrongFigure": "Một bản ghi chưa đúng: chat.<domain> được đánh dấu.",
  "inactive.body": "Đăng nhập tại {host} chưa được thiết lập.",
  "inactive.title": "Chưa thiết lập",
  "iosApp.open.body": "Trang này thuộc app tài khoản Auth Next. Hãy quay lại app để tiếp tục; bạn có thể đóng trang này.",
  "iosApp.open.title": "Mở app",
  "layout.brand": "Tài khoản",
  "layout.description": "Đăng nhập vào tài khoản và quản lý các ứng dụng, thiết bị đã kết nối với tài khoản.",
  "layout.guide": "Hướng dẫn",
