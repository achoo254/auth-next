<path class="hub-line" d="M132 110 C156 110 156 150 180 150"/><path class="hub-flow tone-primary" d="M132 110 C156 110 156 150 180 150"/><path class="hub-line" d="M132 190 C156 190 156 150 180 150"/><path class="hub-flow tone-primary" d="M132 190 C156 190 156 150 180 150"/><path class="hub-line" d="M340 150 C366 150 366 38 392 38"/><path class="hub-flow tone-violet" d="M340 150 C366 150 366 38 392 38"/><path class="hub-line" d="M340 150 C366 150 366 113 392 113"/><path class="hub-flow tone-amber" d="M340 150 C366 150 366 113 392 113"/><path class="hub-line" d="M340 150 C366 150 366 188 392 188"/><path class="hub-flow tone-blue" d="M340 150 C366 150 366 188 392 188"/><path class="hub-line" d="M340 150 C366 150 366 263 392 263"/><path class="hub-flow tone-red" d="M340 150 C366 150 366 263 392 263"/>
