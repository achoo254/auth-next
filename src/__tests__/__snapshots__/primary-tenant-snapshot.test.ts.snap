  "login.cancel": "Huỷ đăng nhập",
  "login.continueTo": "Để tiếp tục tới {app}.",
  "login.firstTime": "Lần đầu đăng nhập bằng một trong các cách trên sẽ tạo tài khoản Auth Next mới.",
  "login.forDevice": "Đăng nhập để duyệt thiết bị.",
  "login.noProvider": "Đăng nhập bằng Google và GitHub đang tạm tắt, nên chưa đăng nhập hay đăng ký được. Thử lại sau.",
  "login.tagline": "Một tài khoản Auth Next cho Localman và Tunelo.",
