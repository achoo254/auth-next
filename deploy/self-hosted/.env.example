# Settings of a self-hosted install (ADR 0007, docs/self-hosted-install.md).
# Copy to .env (mode 600), fill in, then run ./init.sh. init.sh adds PUID,
# PGID and SELFHOSTED_DIR below and writes every generated secret under
# data/ (never into this file).

# The domain claimed at the gateway's /claim in self-hosted mode, and the
# name shown on its pages.
DOMAIN=
DISPLAY_NAME=

# The gateway's issuer and the enrollment bundle downloaded from its /claim.
GATEWAY=https://auth.hoandat.com
ENROLLMENT_BUNDLE=

# Checkouts the images build from (absolute or relative to this folder).
# Use clean checkouts of a release, never a working copy with local edits.
LOCALMAN_SRC=../../../localman-next
CHAT_SRC=../../../chat-next

# Let's Encrypt: the account email, and a Cloudflare API token allowed to
# edit DNS of the zone (DNS-01 is needed for *.localman. and *.tunnel.).
ACME_EMAIL=
CLOUDFLARE_DNS_TOKEN=

# Sign-in: an OAuth app of Google and/or GitHub registered by the owner,
# with the callbacks https://auth.<DOMAIN>/oauth/google/callback and
# https://auth.<DOMAIN>/oauth/github/callback. At least one is required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare Turnstile of Localman's public forms (sign-up, feedback): a
# widget for localman.<DOMAIN> in the owner's Cloudflare account. Required:
# Localman refuses to start in production without it, testing keys too.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# This server's public IPv4: chat refuses outgoing requests (webhooks,
# link previews) to it. Optional but recommended.
PUBLIC_IPV4=

# Tunelo's TCP tunnels: host ports published as they are.
TCP_PORT_RANGE=10000-10099
