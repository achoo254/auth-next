{
	"$schema": "./node_modules/@shared-next/brand/brand.config.schema.json",
	"appName": "Auth Next",
	"shortName": "Auth Next",
	"description": "Sign in to your account and manage the apps and devices connected to it.",
	"colors": {
		"primary": "#6e56cf",
		"background": "#f9f9fb",
		"backgroundDark": "#111113"
	},
	"icon": "brand/app-icon.svg",
	"iconMaskable": "brand/app-icon-maskable.svg",
	"webInstall": false,
	"appIds": {
		"ios": "com.hoandat.account"
	},
	"urlScheme": "com.hoandat.account",
	"primaryTenant": {
		"domain": "hoandat.com",
		"issuer": "https://auth.hoandat.com"
	},
	"hostTemplates": {
		"web": "auth.{domain}"
	}
}
