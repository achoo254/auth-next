{
	"name": "auth-next",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "auth.hoandat.com: self-hosted OpenID Connect identity provider",
	"engines": {
		"node": ">=22.12"
	},
	"packageManager": "pnpm@11.9.0",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/server.ts",
		"build": "tsx scripts/build.ts",
		"start": "node dist/server.mjs",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"guide:screenshots": "playwright test -c playwright.guide.config.ts",
		"generate-key": "tsx scripts/generate-signing-key.ts",
		"review-login:hash": "tsx scripts/review-login-hash.ts",
		"conformance:idp": "tsx e2e/support/conformance-server.ts",
		"check:tokens": "tsx scripts/check-tokens.ts",
		"seed:clients": "tsx --env-file-if-exists=.env scripts/seed-clients.ts"
	},
	"dependencies": {
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"express": "^5.2.1",
		"express-rate-limit": "^8.7.1",
		"helmet": "^8.3.0",
		"jose": "^6.2.12",
		"mongodb": "^7.7.0",
		"oidc-provider": "^9.12.2",
		"openid-client": "^6.8.8",
		"pino": "^9.14.0",
		"tldts": "^7.4.18",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@playwright/test": "^1.63.0",
		"@types/express": "^5.0.6",
		"@types/node": "^22.20.5",
		"@types/oidc-provider": "^9.12.1",
		"esbuild": "^0.27.7",
		"mongodb-memory-server": "^11.3.0",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^3.2.7"
	}
}
